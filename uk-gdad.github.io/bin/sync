#!/bin/sh
# Vendor everything this site builds from into the site project itself, so the
# project stays buildable on its own once it is pushed to its public repository.
#
#   1. Lily Design System reference themes -> static/assets/themes/
#   2. UK GDAD PCF markdown from the sibling projects -> content/
#   3. The standalone skills self-assessment tool -> static/self-assessment/
#
# The Lily Design System Svelte components themselves — headless components,
# theme/locale/text-size/share pickers, and the picker bar — are real npm
# dependencies (see package.json, the @lilydesignsystem/* packages) and are
# not vendored. The 45 reference themes are an npm package too
# (@lilydesignsystem/themes), but the theme picker loads them by URL at
# runtime, so this script still copies them into static/assets/themes/.
#
# Re-run after the upstream sources change:  ./bin/sync
set -eu

site="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
gdad="$(CDPATH= cd -- "$site/.." && pwd)"

# 1. Lily Design System reference themes, loaded by ThemePicker/PickerBar at
# runtime, so they have to be served as static files. They come from the
# @lilydesignsystem/themes npm package. Each line in lily-themes.txt is a theme
# slug, e.g. "dracula" -> dist/dracula.css. This mirrors PickerBar's own
# DEFAULT_THEMES exactly.

lily_themes="$site/node_modules/@lilydesignsystem/themes/dist"
if [ -d "$lily_themes" ]; then
    mkdir -p "$site/static/assets/themes"
    for slug in $(cat "$site/bin/lily-themes.txt"); do
        source_file="$lily_themes/$slug.css"
        if [ -f "$source_file" ]; then
            cp "$source_file" "$site/static/assets/themes/$slug.css"
        else
            echo "sync: missing Lily theme: $slug" >&2
            exit 1
        fi
    done
    echo "sync: @lilydesignsystem/themes -> static/assets/themes/"
else
    echo "sync: @lilydesignsystem/themes is not installed; run pnpm install" >&2
    exit 1
fi

# 2. UK GDAD PCF content.

sync_content() {
    from="$gdad/$1/roles/"
    to="$site/content/$2/"
    if [ ! -d "$from" ]; then
        echo "sync: skipping $2; not found at $from" >&2
        return
    fi
    mkdir -p "$to"
    rsync -a --delete --prune-empty-dirs --include='*/' --include='*.md' --exclude='*' "$from" "$to"
    echo "sync: $1 -> content/$2/"
}

sync_content uk-gdad-pcf-role-summaries role-summaries
sync_content uk-gdad-pcf-role-level-start-here role-level-start-here
sync_content uk-gdad-pcf-upskilling-resources upskilling-resources
sync_content uk-gdad-pcf-continuing-professional-development-checklists continuing-professional-development-checklists
sync_content uk-gdad-pcf-psychometric-assessments-by-assessor assessments-by-assessor
sync_content uk-gdad-pcf-psychometric-assessments-by-individual assessments-by-individual
sync_content uk-gdad-pcf-competency-assessments-by-assessor competency-assessments-by-assessor
sync_content uk-gdad-pcf-competency-assessments-by-individual competency-assessments-by-individual
sync_content uk-gdad-pcf-roles-skills-gap-forms roles-skills-gap-forms

# The old singular assessments/ dir is retired now that it is split in two —
# remove it so a stale copy is never accidentally left in place.
rm -rf "$site/content/assessments"

# 3. Skills self-assessment tool.

self_assessment="$gdad/uk-gdad-pcf-skills-self-assessment/index.html"
if [ -f "$self_assessment" ]; then
    # A directory with its own index.html, not a bare .html file, so the URL
    # takes a trailing slash like every other URL on this site — a bare
    # skills-self-assessment.html has no trailing-slash form that resolves.
    mkdir -p "$site/static/tools/skills-self-assessment"
    rm -f "$site/static/tools/skills-self-assessment.html"
    cp "$self_assessment" "$site/static/tools/skills-self-assessment/index.html"
    echo "sync: uk-gdad-pcf-skills-self-assessment -> static/tools/skills-self-assessment/"
else
    echo "sync: skipping skills self-assessment; not found at $self_assessment" >&2
fi
